%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
include "../SUD_to_UD.grs"

strat sab_SUD_to_UD_main {
  Seq (
    Onf (sab_pre),
    SUD_to_UD_main,
    Onf (sab_post),
  )
}

package sab_pre {
  rule comp {
    pattern { e: X -[comp]-> Y }
    commands { e.label = "comp:obj" }
  }
}

package sab_post {
  rule remove_extensions {
    pattern { e: X -[1=cop, 2=*]-> Y }
    commands { del_feat e.2}
  }

  % one case of double obj --> turn the one with a case into obl
  rule obl {
    pattern { 
      e1: X -[obj]-> O1;
      e2: X -[obj]-> O2; O2 -[case]-> *;
    }
    commands {
      e2.label = obl
    }
  }

}




