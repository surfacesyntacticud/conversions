%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
include "../UD_to_SUD.grs"

strat ht_UD_to_SUD_main {
  Seq (
    Onf (ht_pre),
    UD_to_SUD_main,
    Onf (ht_post),
  )
}

package ht_pre {
  rule iobj_obj {
    pattern {
      V [upos=VERB];
      ei: V -[iobj]-> I;
      eo: V -[obj]-> O;
    }
    commands {
      ei.label = "comp:obj@R";
      eo.label = "comp:obj@T";
    }
  }

  rule iobj_comp {
    pattern { 
      V [upos=VERB];
      ei: V -[iobj]-> I; 
      eo: V -[xcomp|ccomp]-> O; 
    }
    without { V -[obj]-> * } 
    commands {
      ei.label = "comp:obj@R";
      eo.label = "comp:obj@T";
    }
  }

  rule aux {
    pattern { V -[aux]-> A  }
    commands {
      del_edge V -[aux]-> A;
      add_edge V -[KEEP_aux]-> A;
    }
  }
}

package ht_post {
  rule aux {
    pattern { V -[KEEP_aux]-> A  }
    commands {
      del_edge V -[KEEP_aux]-> A;
      add_edge V -[aux]-> A;
    }
  }

}